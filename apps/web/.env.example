# OneMetric — web app environment variables
# Copy to `apps/web/.env` and fill in as each phase is implemented.
# `.env` is gitignored — never commit real secrets.

# --- App (Phase 0) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Database / Prisma (Phase 1 / 1.5) ---
# Supabase project: "OneMetric" (ref: ladsqshpcdyjruzohkvb, region: eu-central-1)
# Replace [YOUR-DB-PASSWORD] with the database password
# (Supabase dashboard → Project Settings → Database → Reset database password).
#
# DATABASE_URL = transaction pooler (port 6543), used by the app at runtime.
# DIRECT_URL   = session pooler (port 5432), used by Prisma for migrations.
# The pooler host is used (not db.<ref>.supabase.co) because Supabase direct
# connections are IPv6-only.
DATABASE_URL="postgresql://postgres.ladsqshpcdyjruzohkvb:[YOUR-DB-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.ladsqshpcdyjruzohkvb:[YOUR-DB-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:5432/postgres"

# --- Supabase Auth (Phase 2) ---
NEXT_PUBLIC_SUPABASE_URL="https://ladsqshpcdyjruzohkvb.supabase.co"
# Publishable key (safe to expose to the browser). Supabase dashboard → Project
# Settings → API Keys → "publishable" (or legacy "anon").
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."
# SUPABASE_SERVICE_ROLE_KEY=       # secret, server-only (not needed in Phase 2)

# --- Ingestion (Phase 3) ---
# Random secret used to hash cookieless visitor ids. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VISITOR_HASH_SALT="generate-a-random-32-byte-hex-string"

# --- Revenue / Integrations (Phase 7) ---
# PayPal credentials are entered per-project in the dashboard and stored encrypted
# with this key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_KEY="generate-a-random-32-byte-hex-string"

# --- Weekly Reports / Email (Phase 8) ---
# Resend API key (https://resend.com). Without it, report emails are skipped.
RESEND_API_KEY=""
# From address (must be a Resend-verified domain in production).
REPORT_FROM_EMAIL="OneMetric <onboarding@resend.dev>"
# Shared secret protecting the weekly-report cron route (Vercel Cron sends it as
# `Authorization: Bearer <CRON_SECRET>`). Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=""
